# ===========================
# Unity 项目通用 .gitignore
# 2025-06 版
# ===========================

# ========== 可完全重建的缓存 ==========
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Ll]ocal[Cc]ache/
[Uu]ser[Ss]ettings/

# ========== IDE 缓存 ==========
# Visual Studio / Rider / VS Code
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
.idea/
.vscode/

# ========== 系统垃圾 ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ========== 可选：Addressables ==========
# 若使用 Addressables 且希望完全重新导入，可取消下一行注释
# [Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin

# ========== 可选：Plastic / Cloud Build =========*
# 若团队用 Plastic 或 Cloud Build 自动生成，可取消下一行注释
# *.cloudBuild

# ========== 可选：FMOD ==========
# 若使用 FMOD，取消下一行可忽略本地缓存
# [Aa]ssets/Plugins/FMOD/Cache/

# ========== 尾注：必须纳入版本控制 ==========
# Assets/
# ProjectSettings/
# Packages/manifest.json
# 任何自定义 .gitignore 本身